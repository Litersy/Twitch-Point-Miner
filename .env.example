# ========== App ==========
NODE_ENV=production
APP_PORT=4000
APP_PUBLIC_URL=http://localhost:8080

# JWT secret (generate: openssl rand -hex 32)
APP_JWT_SECRET=replace_me_with_64_hex_chars

# AES-256-GCM master key for encrypting Twitch credentials (MUST be 32 bytes hex = 64 chars)
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace_me_with_64_hex_chars

# ========== First admin user (created only on first start if no users exist) ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ========== Postgres ==========
POSTGRES_USER=twf
POSTGRES_PASSWORD=twf_password
POSTGRES_DB=twf

# ========== Public port (nginx) ==========
PUBLIC_PORT=8080
